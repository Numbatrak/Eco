# Copy to `.env.local` and fill in values (same as Netlify production env).

# apps/api base URL - this app now talks to the monorepo's own backend
# (Fastify + Better Auth) instead of Supabase directly. Defaults to
# http://localhost:3001 if unset.
VITE_API_URL=http://localhost:3001

# Legacy — only still needed by pages not yet ported off Supabase (everything
# except /agents). See the numbatrak frontend-port plan.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — Google sign-in (if enabled)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Scripts only (never expose in client builds)
# VITE_SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets (set with `supabase secrets set ...`, not in frontend env files)
# Production email checklist (Brevo):
#   1. supabase secrets set BREVO_API_KEY=... BREVO_SMTP_KEY=... EMAIL_FROM_ADDRESS=... EMAIL_FROM_NAME=... APP_URL=...
#   2. Verify sender domain in Brevo (SPF/DKIM)
#   3. Supabase Dashboard → Auth → URL configuration: Site URL + redirect URLs for prod and localhost
#   4. Smoke-test: signup OTP, resend OTP, password reset, org invitation
# APP_URL=https://www.numbatrak.io
#
# Supabase Dashboard → Authentication → URL configuration:
# Site URL: https://www.numbatrak.io
# Additional redirect URLs:
#   https://www.numbatrak.io/**
#   https://numbatrak.io/**
#   http://localhost:3000/**
#   http://localhost:3001/**
# EMAIL_FROM_ADDRESS=numbatrak@gmail.com
# EMAIL_FROM_NAME=Numbatrak
# BREVO_SMTP_KEY=
# BREVO_API_KEY=
# BREVO_SMTP_LOGIN=b04af8001@smtp-brevo.com
# BREVO_SMTP_SERVER=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
