NEXT_PUBLIC_API_URL="http://localhost:3001"

# The bare base domain (no protocol) tenant subdomains sit under, e.g.
# "acme.localhost:3000" -> subdomain "acme" when BASE_DOMAIN="localhost:3000".
# In production this would be your real apex domain, e.g. "example.com".
BASE_DOMAIN="localhost:3000"

# Same value as BASE_DOMAIN, exposed to the browser - the dashboard's site
# builder (a client component) can't read the server-only BASE_DOMAIN, so it
# needs its own NEXT_PUBLIC_ copy for the Publish/Visit Site links. Keep
# these two in sync.
NEXT_PUBLIC_BASE_DOMAIN="localhost:3000"
