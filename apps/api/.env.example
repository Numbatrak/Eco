DATABASE_URL="postgresql://user:password@localhost:5432/platform"
# Separate database for the Vitest suite's Tier B (real-DB) tests - must
# have the same migrations applied as DATABASE_URL, never point this at a
# database with real data (tests truncate every table between runs).
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/platform_test"
PORT=3001
REDIS_URL="redis://localhost:6379"

# Base URL of apps/admin - used for CORS (with credentials) and for building
# links (email verification) that point back at the SPA.
PUBLIC_APP_URL="http://localhost:3002"

# Base URL of apps/numbatrak/numbatrak - used for CORS (with credentials).
# A separate Vite SPA (not proxied through Next.js like the storefront), so
# this is genuine cross-origin.
NUMBATRAK_APP_URL="http://localhost:3003"

# Better Auth's signing secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# This API's own base URL (Better Auth uses it to build callback/redirect links).
BETTER_AUTH_URL="http://localhost:3001"

# 32-byte AES-256-GCM key, base64-encoded, e.g. `openssl rand -base64 32`.
# Used for tenant payment-provider secret keys. 2FA secrets/backup codes are
# encrypted internally by Better Auth's twoFactor plugin instead.
SECRET_ENCRYPTION_KEY=""

# Reserved subdomains now live in the reserved_subdomains table (seeded from
# this same word list by packages/db/drizzle/0006_*.sql), managed via
# GET/POST/DELETE /platform-admin/reserved-subdomains - no env var anymore.

# Paystack/Flutterwave webhook calls hit these directly - no auth, verified by signature.
CHECKOUT_RATE_LIMIT_PER_MINUTE=10

# Template for the published-storefront URL a payment provider's hosted
# checkout redirects back to - {subdomain} is substituted per-tenant.
STOREFRONT_BASE_URL_TEMPLATE="http://{subdomain}.localhost:3000"
