DATABASE_URL="postgresql://user:password@localhost:5432/platform"
PORT=3001
REDIS_URL="redis://localhost:6379"

# HS256 signing secrets - use distinct random values, e.g. `openssl rand -base64 32`
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
MFA_CHALLENGE_SECRET=""

# 32-byte AES-256-GCM key, base64-encoded, e.g. `openssl rand -base64 32`
TOTP_ENCRYPTION_KEY=""

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_CHALLENGE_TTL_SECONDS=300
